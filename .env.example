# Copy to .env and fill locally. Secret values must never be committed.
APP_AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_SECRET_KEY=
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8083
DEVELOPER_SUBJECTS=
DEVELOPER_HOST=developers.tickit.site
APP_SEED_ENABLED=false
EMAIL_ENABLED=false
# Render Free blocks SMTP ports. Use the HTTPS transport after free account/sender verification.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
# Set the verified owner email during initial delivery acceptance. Empty permits all recipients.
EMAIL_ALLOWED_RECIPIENTS=
APP_PUBLIC_URL=https://tickit-mpy2.onrender.com
SMTP_HEALTH_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=

# Optional Neon provider URLs. Never commit populated values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Set true only after Neon deploy provides branch-scoped S3 credentials.
APP_STORAGE_ENABLED=false
NEON_STORAGE_BUCKET=assets
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay test mode only. Keep disabled until test-account keys and webhooks are configured.
PAYMENTS_ENABLED=false
# Automatic full-refund worker. Disable only for isolated provider tests.
PAYMENT_REFUNDS_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
