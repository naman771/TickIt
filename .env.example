# Copy to .env and fill locally. Secret values must never be committed.
APP_AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_SECRET_KEY=
AUTH_ALLOWED_ORIGINS=http://localhost:8081
DEVELOPER_SUBJECTS=
DEVELOPER_HOST=developers.tickit.site
APP_SEED_ENABLED=false
EMAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=

# Optional Neon provider URLs. Never commit populated values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
